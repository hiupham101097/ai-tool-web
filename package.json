{
  "name": "ai-site-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && wrangler pages functions build --outdir dist",
    "preview": "wrangler pages dev dist --d1=DB",
    "db:local": "wrangler d1 migrations apply ai-site-builder --local",
    "db:remote": "wrangler d1 migrations apply ai-site-builder --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wrangler": "^4.151.3"
  }
}
